# ─── Motor de IA ────────────────────────────────────────────────
# Proveedor preferido: deepseek | kimi | claude
# Si no hay ninguna clave, el chat funciona igual en "modo básico" (reglas).
LLM_PROVIDER=deepseek

# DeepSeek — el más barato para este caso (~USD 0,14 por millón de tokens)
# Clave en https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Kimi / Moonshot — https://platform.moonshot.ai
MOONSHOT_API_KEY=

# Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional: forzar un modelo distinto al por defecto del proveedor
# deepseek-v4-flash (default) · deepseek-v4-pro · kimi-k2.6 · kimi-k3
# LLM_MODEL=deepseek-v4-flash

PORT=3000
